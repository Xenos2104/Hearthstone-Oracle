{
  "name": "@xenos2104/hearthstone-oracle",
  "version": "0.2.0",
  "description": "Hearthstone MCP server with card search, deck analysis, and strategy coaching",
  "type": "module",
  "license": "MIT",
  "main": "dist/server.js",
  "bin": {
    "hearthstone-oracle": "dist/server.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "dist/data/schema.sql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xenos2104/Hearthstone-Oracle.git"
  },
  "bugs": {
    "url": "https://github.com/Xenos2104/Hearthstone-Oracle/issues"
  },
  "homepage": "https://github.com/Xenos2104/Hearthstone-Oracle#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^12.8.0",
    "deckstrings": "^2.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "hearthstone",
    "card-game",
    "strategy",
    "deck-analysis"
  ]
}
